{
	"name": "desktop-bar",
	"exclusive": false,
	"layer": "bottom",
	"position": "right",

	"modules-right": ["tray", "backlight", "battery", "pulseaudio", "network", "clock"],
	"margin": 14,
    "spacing": 5,

	"battery": {
		"format": "{icon}  {capacity}%",
		"format-charging": "{icon}󱐋 {capacity}%",
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
	},

    "backlight": {
		"format": "{icon}   {percent}%",
		"format-icons": ["󰛩", "󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
        "on-scroll-down": "",
        "on-scroll-up": "",
        "tooltip": false
	},

    "network": {
        "interval": 60,
        "format": "{ifname} connected",
        "format-wifi": "{icon}   {essid}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨" ],
        "format-ethernet": "󰈀   connected",
        "format-disconnected": "󰲛   disconnected",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-icons": ["", "", ""],
        "format-bluetooth": "󰂰   {volume}%",
        "format-muted": "   muted",
        "on-scroll-down": "",
        "on-scroll-up": "",
        "on-click": "pamixer -t"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 4,
            "format": {
                "months":     "<span color='#918c7e'><b>{}</b></span>",
                "days":       "<span><b>{}</b></span>",
                "weekdays":   "<span color='#918c7e'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
    },
}
