{
	// Also becomes the layer-shell namespace, which waybar-overlay matches on
	"name": "overlay-bar",
	"exclusive": false,
	// Drawn above windows, but hidden until ~/.local/bin/waybar-overlay shows it
	"layer": "overlay",
	"start_hidden": true,
	"position": "bottom",
	// 50% of eDP-1's 1920 logical px, fixed rather than proportional
	"width": 960,
	// Waybar sizes the surface itself, CSS padding on the window will not do it
	"height": 44,

	"modules-left": ["hyprland/workspaces"],
	"modules-right": ["tray", "network", "battery", "backlight", "pulseaudio", "clock"],
	// Flush with the bottom edge, no floating gap
	"margin-bottom": 0,
    "spacing": 0,

    "hyprland/workspaces": {
        "format": "{icon}",
        // Japanese numerals. These are full width CJK glyphs, so they are
        // already uniform, the min-width in style.css just sets the spacing.
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "default": "•"
        },
        "on-click": "activate"
    },

    "tray": {
        "icon-size": 24,
        "spacing": 6
    },

	"battery": {
		"format": "{icon}   {capacity}%",
		"format-charging": "{icon}󱐋  {capacity}%",
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
	},

    "backlight": {
		"format": "{icon}   {percent}%",
		"format-icons": ["󰛩", "󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
        "on-scroll-down": "",
        "on-scroll-up": "",
        "tooltip": false
	},

    "network": {
        "interval": 60,
        "on-click": "gtk-launch nmtui",
        // Short label only, the network name lives in the tooltip
        "format": "{ifname}",
        "format-wifi": "{icon}   WiFi",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨" ],
        "format-ethernet": "󰈀   Eth",
        "format-disconnected": "󰲛   Off",
        "tooltip": true,
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid}   {signalStrength}%",
        "tooltip-format-ethernet": "{ifname} connected",
        "tooltip-format-disconnected": "Disconnected"
    },

    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-icons": ["", "", ""],
        "format-bluetooth": "󰂰   {volume}%",
        "format-muted": "   muted",
        "on-scroll-down": "",
        "on-scroll-up": "",
        "on-click": "pamixer -t"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 4,
            "format": {
                "months":     "<span color='#918c7e'><b>{}</b></span>",
                "days":       "<span><b>{}</b></span>",
                "weekdays":   "<span color='#918c7e'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
    },
}
